    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
