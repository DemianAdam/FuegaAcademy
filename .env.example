# Browser-safe Convex client URL.
VITE_CONVEX_URL=

# Local-only tunnel configuration. Copy into your shell profile or a local, ignored .env file;
# it is not a Mercado Pago credential and must contain only the reserved ngrok hostname.
# NGROK_STATIC_DOMAIN=fuega-dev.ngrok-free.app

# Backend-only variables belong in the Convex development deployment, not this file:
# SITE_URL=http://localhost:3000
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# CONVEX_SITE_URL=
